			"import": "./src/index.ts"
		}
	},
	"dependencies": {
		"@zarrita/storage": "workspace:^",
		"numcodecs": "^0.3.2"
	},
	"devDependencies": {
		"@types/ndarray": "^1.1.0",
		"@types/ndarray-ops": "^1.2.7",
		"ndarray": "^1.1.1",
		"ndarray-ops": "^1.2.2"
	},
	"publishConfig": {
		"main": "dist/src/index.js",
		"exports": {
			".": {
				"types": "./dist/src/index.d.ts",
				"import": "./dist/src/index.js"
			}
		}
